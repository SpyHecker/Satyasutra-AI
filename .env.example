# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# MongoDB Connection URL (Local or MongoDB Atlas)
# Example Local: mongodb://localhost:27017
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=satyasutra

# Authentication / JWT
JWT_SECRET_KEY=satyasutra-forensic-ai-jwt-secret-key-2026

# Legit Administrator Credentials
ADMIN_EMAIL=admin@satyasutra.ai
ADMIN_PASSWORD=Admin@SatyaSutra2026!

# Neo4j (optional — defaults to NetworkX if not set)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Tesseract OCR binary path (set if not on PATH)
TESSERACT_CMD=tesseract
